{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/login",
      "destination": "/spa.html"
    },
    {
      "source": "/register",
      "destination": "/spa.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/spa.html"
    },
    {
      "source": "/reset-password",
      "destination": "/spa.html"
    },
    {
      "source": "/verify-email",
      "destination": "/spa.html"
    },
    {
      "source": "/dashboard",
      "destination": "/spa.html"
    },
    {
      "source": "/my-appointments",
      "destination": "/spa.html"
    },
    {
      "source": "/salons",
      "destination": "/spa.html"
    },
    {
      "source": "/admin",
      "destination": "/spa.html"
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/spa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
