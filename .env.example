# ---------------------------------------------------------------------------
# BeautyZone environment configuration
# Copy this file to `.env` and fill in the values you need.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Supabase (publishable key only; NEVER put a service_role/secret key in VITE_* variables)
SUPABASE_URL=https://botkjeikjzhnbxnowdkl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_f2nHVHcAdrlosQbZwAAxnQ_vnHQuuv0
# Server-only Supabase secret key used for restricted loyalty booking-award RPCs. Never prefix with VITE_.
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=https://botkjeikjzhnbxnowdkl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f2nHVHcAdrlosQbZwAAxnQ_vnHQuuv0

# Where SQLite data + uploaded images live (defaults to ./data)
# DATA_DIR=./data

# Public base URL used in emails and links (verification, review notifications).
# Falls back to the request host when empty.
APP_URL=

# Google Sign-In (optional). Create an OAuth 2.0 Web Client ID in Google Cloud
# Console and add your app origin under "Authorized JavaScript origins".
# When empty, the Google button is shown as unavailable and the API rejects
# Google login attempts instead of trusting client-supplied tokens.
GOOGLE_CLIENT_ID=

# Extra origins allowed to send cookie-authenticated writes (comma separated).
# The app's own origin is always allowed. Useful for a separate preview domain.
ALLOWED_ORIGINS=

# First-boot demo accounts. Only used when the database has no users yet.
# CHANGE THESE before deploying to production.
SEED_ADMIN_EMAIL=admin@beautyzone.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OWNER_EMAIL=owner@luminaluxe.in
SEED_OWNER_PASSWORD=Owner@12345

# ---------------------------------------------------------------------------
# Booking payments
# ---------------------------------------------------------------------------
# PAYMENT_MODE=mock       → built-in test checkout (default in development).
# PAYMENT_MODE=razorpay   → live/test Razorpay orders + signature verification.
#
# Mock payments are hard-blocked when NODE_ENV=production.
PAYMENT_MODE=mock

# Percentage of the service price collected as an advance at booking time.
# Set to 0 (or PAYMENT_REQUIRE_ADVANCE=false) to allow "pay at the salon".
PAYMENT_ADVANCE_PERCENT=25

# Defaults to true whenever a payment provider is available. Set explicitly to
# true to fail closed when no provider is configured.
# PAYMENT_REQUIRE_ADVANCE=true

# How long an unpaid booking holds its slot before it is released.
PAYMENT_HOLD_MINUTES=30

# Razorpay (only used when PAYMENT_MODE=razorpay). Keep secrets server-side.
# Use rzp_test_* keys while you are still testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Razorpay overrides
# RAZORPAY_CURRENCY=INR
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
# RAZORPAY_VERIFY_PAYMENT_API=true

# ---------------------------------------------------------------------------
# Salon-owner advance payment settings
# ---------------------------------------------------------------------------
# The platform variables above (PAYMENT_ADVANCE_PERCENT / PAYMENT_REQUIRE_ADVANCE)
# are only the DEFAULTS. Each salon owner overrides them from their dashboard
# (Booking & Advance Payment Settings): percentage or fixed ₹ advance,
# per-service overrides, balance policy (pay at salon / online), and which
# payment methods are offered. Those settings live in the database, not here.
#
# Direct UPI QR payments: a salon owner can enable "manual UPI" in the dashboard
# and add their own UPI ID + QR code. Customers scan/pay and submit the UPI
# transaction reference (UTR); the booking stays `payment_verification_pending`
# until the owner verifies the credit. No extra server env is required.
# Administrators monitor personal UPI payments but cannot verify another salon's bank credit.
#
# Automatic settlement: configure Razorpay Route, complete each salon's external merchant
# onboarding/KYC, save its acc_... linked account, and mark it verified from the actual provider
# dashboard. Production salon orders will not fall back to the platform's ordinary Razorpay account.
# See docs/SALON_OWNER_PAYMENTS.md for migrations, private proof storage and deployment.
# DATA_DIR must be on durable storage in production; Vercel /tmp is not a financial-record store.

# ---------------------------------------------------------------------------
# WhatsApp Business receipts (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------------------
# Disabled by default. When disabled, receipt notifications are recorded as
# `skipped` (never "sent") and the booking is unaffected; owners can still
# download the receipt and retry later.
#   WHATSAPP_PROVIDER=meta_cloud  → send approved-template receipts
#   WHATSAPP_PROVIDER=disabled    → no sends (default)
WHATSAPP_PROVIDER=disabled

# Permanent system-user access token + sender phone number id from Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Approved message template (see docs/WHATSAPP.md for the exact 14-parameter
# body + URL button layout) and its language code.
WHATSAPP_TEMPLATE_NAME=booking_confirmation_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en

# Graph API base (override only for a proxy / tests).
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# Webhook subscription verify token + Meta app secret (X-Hub-Signature-256).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# NOTE: APP_URL (above) must be set to your public https origin so the WhatsApp
# receipt button links to a reachable /receipt/<bookingId>?token=… page.

# Optional Gemini key for the AI assist endpoints (/api/ai/*).
# When empty (or the provider fails / times out) every AI endpoint still answers
# 200 using deterministic local templates — the UI never blocks on the model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_TIMEOUT_MS=12000

# Optional build-time sitemap source: the deployed public paginated slug feed.
# On Vercel the build defaults to the production site's /api/public/sitemap-salons.
# Otherwise it reads DATABASE_PATH or DATA_DIR/beautyzone.db (or ./data/beautyzone.db).
# SITEMAP_SALONS_API_URL=https://beauty-zone-pearl.vercel.app/api/public/sitemap-salons
