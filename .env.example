# ---------------------------------------------------------------------------
# BeautyZone environment configuration
# Copy this file to `.env` and fill in the values you need.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Where SQLite data + uploaded images live (defaults to ./data)
# DATA_DIR=./data

# Public base URL used in emails and links (verification, review notifications).
# Falls back to the request host when empty.
APP_URL=

# Google Sign-In (optional). Create an OAuth 2.0 Web Client ID in Google Cloud
# Console and add your app origin under "Authorized JavaScript origins".
# When empty, the Google button is shown as unavailable and the API rejects
# Google login attempts instead of trusting client-supplied tokens.
GOOGLE_CLIENT_ID=

# Extra origins allowed to send cookie-authenticated writes (comma separated).
# The app's own origin is always allowed. Useful for a separate preview domain.
ALLOWED_ORIGINS=

# First-boot demo accounts. Only used when the database has no users yet.
# CHANGE THESE before deploying to production.
SEED_ADMIN_EMAIL=admin@beautyzone.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OWNER_EMAIL=owner@luminaluxe.in
SEED_OWNER_PASSWORD=Owner@12345

# Optional Gemini key for the AI assist endpoints (/api/ai/*).
# When empty (or the provider fails / times out) every AI endpoint still answers
# 200 using deterministic local templates — the UI never blocks on the model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Supabase Auth (sign up / sign in / forgot password)
# Public values (safe in the browser). Leave empty to use the built-in cookie auth.
# Also set the same two as VITE_* in Vercel so the browser bundle gets them.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://botkjeikjzhnbxnowdkl.supabase.co
SUPABASE_ANON_KEY=sb_publishable_f2nHVHcAdrlosQbZwAAxnQ_vnHQuuv0
VITE_SUPABASE_URL=https://botkjeikjzhnbxnowdkl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_f2nHVHcAdrlosQbZwAAxnQ_vnHQuuv0

# ---------------------------------------------------------------------------
# Supabase data layer (migration in phases; see docs/superpowers/specs)
# DATA_BACKEND=sqlite keeps the local database (default). Set to `supabase` only
# once SUPABASE_SERVICE_ROLE_KEY is configured.
# The service-role key BYPASSES RLS: server-side only. Never prefix it with VITE_
# and never commit it. Set it in Vercel > Project > Environment Variables.
# ---------------------------------------------------------------------------
DATA_BACKEND=sqlite
SUPABASE_SERVICE_ROLE_KEY=
